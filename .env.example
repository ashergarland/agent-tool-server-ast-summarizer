NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-ast-summarizer
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
# Comma-separated. Each key must be randomly generated: openssl rand -hex 32
# Short, repetitive, or low-entropy keys are refused at startup.
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# The single readable workspace. Required for HTTP: without it the server starts but never reports
# ready and every tool call fails with not_ready. Local stdio defaults to its launch directory.
AST_WORKSPACE_ROOT=

# Deployment ceilings. A tool call may lower any of these but can never raise one.
AST_MAX_FILE_BYTES=1048576
AST_MAX_TOTAL_BYTES=8388608
AST_MAX_DEPTH=8
AST_MAX_FILES=200
AST_MAX_EDGES=2000
AST_MAX_DECLARATIONS=500
AST_MAX_MEMBERS=200
AST_MAX_JSDOC_CHARS=600
AST_MAX_RESULT_CHARS=120000
AST_REQUEST_TIMEOUT_MS=15000

# Analysis is CPU-bound, so concurrency stays small and surplus demand is rejected as retryable.
AST_MAX_CONCURRENT_JOBS=2
AST_MAX_QUEUED_JOBS=8

# Private and #private members are excluded unless a deployment opts in.
AST_INCLUDE_PRIVATE_MEMBERS=false

# single-file infers types from the one file already loaded; off returns unknown with a warning.
AST_TYPE_INFERENCE=single-file
